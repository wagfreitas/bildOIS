# Oracle Fusion Cloud SCM Configuration
ORACLE_BASE_URL=https://your-instance.fa.ocs.oraclecloud.com
ORACLE_USERNAME=your-username@your-domain.com
ORACLE_PASSWORD=your-password-here

# Master Organization Configuration
MASTER_ORG_CODE=ITEM_MESTRE
DEFAULT_ITEM_CLASS=Root Item Class
DEFAULT_STATUS=Active
DEFAULT_UOM=Each
DEFAULT_LIFECYCLE=Production

# API Configuration
API_VERSION=11.13.18.05
PORT=3000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
